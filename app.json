{
  "expo": {
    "name": "velnora",
    "slug": "velnora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F7F9",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.velnora",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "./plugins/withVelnoraSms",
        {
          "supportedSenderPatterns": [
            "^[A-Z0-9 -]{4,30}$"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Velnora uses your photos only when you choose a receipt image to attach to a transaction.",
          "cameraPermission": "Velnora uses the camera only when you capture a receipt or bill photo for a transaction.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Velnora uses your location only when you tap 'Use my location' to place a pin for a transaction. It never tracks you in the background."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F9",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#0E1014"
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
