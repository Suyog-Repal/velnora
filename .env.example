# ==============================================================================
# Velnora - repository-root environment template (placeholders only; copy to .env, which is git-ignored)
#
# MOBILE APP (Expo). Only variables prefixed EXPO_PUBLIC_ reach the app, and they are embedded in the
# shipped bundle - so NEVER put secrets here.
#
# BACKEND settings live in backend/.env.example (copy to backend/.env).
# ==============================================================================

# Backend API base URL (no trailing slash).
#   Development : leave empty to auto-detect the Expo dev-server host on port 8000, or set your PC's LAN address
#                 e.g. http://<your-pc-lan-ip>:8000   (your own machine's address - do not commit it)
#   Production  : set to your deployed backend, e.g. https://<your-render-service>.onrender.com
#                 It must be https:// for release builds. It is inlined at build time, so set it BEFORE building.
EXPO_PUBLIC_API_URL=
