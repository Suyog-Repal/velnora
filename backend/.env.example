# ==============================================================================
# Velnora backend environment template  (placeholders only - never put real secrets in this file)
#
# Local development : copy to backend/.env and fill in your own values (backend/.env is git-ignored).
# Production (Render): do NOT use a file. Add these as Environment Variables on the Render service.
# See docs/RENDER_DEPLOYMENT.md.
# ==============================================================================

# development | staging | production.  In "production" the API refuses to start with a missing/weak
# JWT secret, a placeholder DATABASE_URL, or a wildcard CORS origin (legacy alias: VELNORA_ENV).
ENVIRONMENT=development

# PostgreSQL connection URL used by the running API. postgres:// and postgresql:// are accepted and
# converted to the psycopg driver automatically.
#   Neon (use the POOLED host, "-pooler"):
#     postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
#   Render PostgreSQL (use the Internal URL when the API runs on Render, External URL from your PC):
#     postgresql://<user>:<password>@<host>/<dbname>
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>

# OPTIONAL. Direct (non-pooled) URL used only by Alembic migrations. If omitted it is derived from
# DATABASE_URL (Neon: the "-pooler" suffix is removed; other providers: the same URL is used).
# DIRECT_DATABASE_URL=postgresql://<user>:<password>@<direct-host>/<dbname>

# JWT signing secret, at least 32 random characters (legacy alias: VELNORA_JWT_SECRET). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate-a-long-random-secret>

# Token lifetimes (defaults shown; omit to keep the defaults).
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated allowed web origins. Native mobile requests are not affected by CORS. Never use * in production.
VELNORA_CORS_ORIGINS=http://localhost:8081

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# Local `python -m backend.app` only (Render injects PORT itself):
# VELNORA_HOST=0.0.0.0
# VELNORA_PORT=8000
