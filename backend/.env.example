# ==============================================================================
# Velnora Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholder values with your credentials.
# ==============================================================================

# Neon PostgreSQL Pooled Connection (for normal FastAPI runtime operations via PgBouncer)
DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# Neon PostgreSQL Direct Connection (for Alembic migrations and administrative operations)
DIRECT_DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require

# Secure JWT Secret Key for token signing and verification (min 32 characters)
JWT_SECRET_KEY=your-secure-jwt-secret-key-min-32-chars

# Backward-compatibility alias for existing auth module
VELNORA_JWT_SECRET=your-secure-jwt-secret-key-min-32-chars

# Runtime Environment (development | staging | production)
ENVIRONMENT=development
VELNORA_ENV=development
